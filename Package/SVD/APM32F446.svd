                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Idle character bit count starts after stop bit.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
