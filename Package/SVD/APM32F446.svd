                                    <description>Configures RXWUPCTRL for idle-line wakeup.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Configures RXWUPCTRL with address-mark wakeup.</description>
                                    <value>#1</value>
                                </enumeratedValue>
