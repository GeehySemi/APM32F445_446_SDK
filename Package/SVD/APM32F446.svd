                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>LPUART is disabled in Doze mode.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
