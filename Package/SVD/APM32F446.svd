                                    <description>Protocol Exception is disabled.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Protocol Exception is enabled.</description>
                                    <value>#1</value>
                                </enumeratedValue>
