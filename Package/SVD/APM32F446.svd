                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>No destination offset configuration error</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The last recorded error was a configuration error detected in the TCDn_DADDRSOF field. TCDn_DADDRSOF is inconsistent with TCDn_TATT[DSIZE].</description>
                                    <value>#1</value>
                                </enumeratedValue>
