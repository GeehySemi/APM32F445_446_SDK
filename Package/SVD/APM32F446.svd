                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>CAN operates using the ISO CAN FD protocol (ISO 11898-1).</description>
                                    <value>#1</value>
                                </enumeratedValue>
