                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>MB6 completed transmission/reception when MCFG[FIFOEN]=0, or Rx FIFO almost full when MCFG[FIFOEN]=1</description>
                                    <value>#1</value>
