                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>MB5 completed transmission/reception when MCFG[FIFOEN]=0, or frame(s) available in the Rx FIFO when MCFG[FIFOEN]=1. It generates a DMA request in case of MCFG[FIFOEN] and MCR[DMA] are enabled.</description>
                                    <value>#1</value>
