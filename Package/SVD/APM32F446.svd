                                    <name>0000</name>
                                    <description>The PCSx is active low.</description>
                                    <value>#0000</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0001</name>
                                    <description>The PCSx is active high.</description>
                                    <value>#0001</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>MCFG</name>
                            <description>Match Configure</description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>000</name>
                                    <description>Match is disabled.</description>
                                    <value>#000</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>010</name>
                                    <description>010b - Match is enabled, if 1st data word equals COMPVAL0 OR COMPVAL1, i.e., (1st data word = COMPVAL0 + COMPVAL1)</description>
                                    <value>#010</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>011</name>
                                    <description>011b - Match is enabled, if any data word equals COMPVAL0 OR COMPVAL1, i.e., (any data word = COMPVAL0 + COMPVAL1)</description>
                                    <value>#011</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>100</name>
                                    <description>100b - Match is enabled, if 1st data word equals COMPVAL0 AND 2nd data word equals COMPVAL1, i.e., [(1st data word = COMPVAL0) * (2nd data word = COMPVAL1)]</description>
                                    <value>#100</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>101</name>
                                    <description>101b - Match is enabled, if any data word equals COMPVAL0 AND the next data word equals COMPVAL1, i.e., [(any data word = COMPVAL0) * (next data word = COMPVAL1)]</description>
                                    <value>#101</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>110</name>
                                    <description>110b - Match is enabled, if (1st data word AND COMPVAL1) equals (COMPVAL0 AND COMPVAL1), i.e., [(1st data word * COMPVAL1) = (COMPVAL0 * COMPVAL1)]</description>
                                    <value>#110</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>111</name>
                                    <description>111b - Match is enabled, if (any data word AND COMPVAL1) equals (COMPVAL0 AND COMPVAL1), i.e., [(any data word * COMPVAL1) = (COMPVAL0 * COMPVAL1)]</description>
                                    <value>#111</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>IOPCFG</name>
                            <description>Input/Output Pin Configure</description>
                            <bitOffset>24</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
