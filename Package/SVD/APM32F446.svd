                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Single-wire LPUART mode where the TXD pin is connected to the transmitter output and receiver input.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
